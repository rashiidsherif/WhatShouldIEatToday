<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: a deep sage field matching the app's theme.
  Kept flat apart from a soft vertical gradient so the mark on top stays
  legible once the launcher masks it into a circle or squircle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF5C7F60" />
                <item android:offset="1" android:color="#FF3A5640" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
